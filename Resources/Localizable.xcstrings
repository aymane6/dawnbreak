    "mission.squats.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squats are counted by the front camera. Allow the camera in Settings, or skip this once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب القرفصاء بالكاميرا الأمامية. اسمح بالكاميرا من الإعدادات أو تخطَّ هذه المرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kniebeugen werden von der Frontkamera gezählt. Erlaube die Kamera in den Einstellungen oder überspringe dieses Mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sentadillas se cuentan con la cámara frontal. Permite la cámara en Ajustes, o sáltalo esta vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les squats sont comptés par la caméra avant. Autorisez la caméra dans Réglages, ou passez cette fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्वैट फ़्रंट कैमरे से गिने जाते हैं। सेटिंग में कैमरा की अनुमति दें, या इस बार छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli squat vengono contati dalla fotocamera frontale. Consenti la fotocamera in Impostazioni o salta per questa volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクワットは前面カメラで数えます。設定でカメラを許可するか、今回は飛ばしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스쿼트는 전면 카메라로 셉니다. 설정에서 카메라를 허용하거나 이번만 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agachamentos são contados pela câmera frontal. Permita a câmera em Ajustes ou pule desta vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приседания считает фронтальная камера. Разрешите камеру в настройках или пропустите на этот раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深蹲由前置摄像头计数。请在“设置”中允许相机，或本次跳过。"
          }
        }
      }
    },
