      }
    },
    "typing.sentence.long.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning is the only part of the day nobody else has claimed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصباح هو الجزء الوحيد من اليوم الذي لم يطالب به أحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Morgen ist der einzige Teil des Tages, den niemand sonst beansprucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mañana es la única parte del día que nadie más ha reclamado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matin est la seule partie de la journée que personne d’autre n’a réclamée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुबह दिन का वह एकमात्र हिस्सा है जिस पर किसी और का दावा नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mattino è l’unica parte del giorno che nessun altro ha rivendicato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝は、まだ誰にも取られていない唯一の時間だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침은 아직 아무도 차지하지 않은 유일한 시간이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A manhã é a única parte do dia que ninguém mais reivindicou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Утро — единственная часть дня, которую ещё никто не занял."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清晨是一天中唯一还没被别人占用的部分。"
          }
        }
      }
    },
    "typing.sentence.long.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are three sentences away from the rest of your life."
