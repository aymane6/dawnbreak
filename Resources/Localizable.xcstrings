    "permission.alarm.deniedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak cannot ring until you allow alarms. Nothing on this screen will wake you up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Dawnbreak أن يرن حتى تسمح بالمنبهات. لن يوقظك أي شيء في هذه الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak kann nicht klingeln, solange du Alarme nicht erlaubst. Nichts auf diesem Bildschirm weckt dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak no puede sonar hasta que permitas las alarmas. Nada de esta pantalla te despertará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak ne peut pas sonner tant que vous n’autorisez pas les alarmes. Rien sur cet écran ne vous réveillera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप अलार्म की अनुमति नहीं देते, Dawnbreak बज नहीं सकता। इस स्क्रीन पर कुछ भी आपको नहीं जगाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak non può suonare finché non consenti le sveglie. Niente in questa schermata ti sveglierà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームを許可するまで Dawnbreak は鳴りません。この画面にあるものではあなたは起きられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 허용하기 전까지 Dawnbreak는 울릴 수 없습니다. 이 화면의 어떤 것도 당신을 깨우지 못합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak não pode tocar até você permitir alarmes. Nada nesta tela vai te acordar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak не сможет прозвонить, пока вы не разрешите будильники. Ничто на этом экране вас не разбудит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你允许闹钟之前，Dawnbreak 无法响铃。此页面上的任何内容都不会叫醒你。"
          }
        }
      }
    },
