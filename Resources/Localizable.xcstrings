    "error.tooManyAlarms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS allows a limited number of alarms at once. Turn one off to add this one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح iOS بعدد محدود من المنبهات في الوقت نفسه. أوقف أحدها لإضافة هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS erlaubt nur eine begrenzte Zahl gleichzeitiger Alarme. Schalte einen aus, um diesen hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS permite un número limitado de alarmas a la vez. Desactiva una para añadir esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS limite le nombre d’alarmes simultanées. Désactivez-en une pour ajouter celle-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS एक समय में सीमित अलार्म की अनुमति देता है। इसे जोड़ने के लिए एक बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS consente un numero limitato di sveglie attive. Disattivane una per aggiungere questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が同時に登録できるアラーム数には上限があります。追加するには 1 つオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 동시에 등록할 수 있는 알람 수에 제한이 있습니다. 하나를 끄고 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS permite um número limitado de alarmes ao mesmo tempo. Desative um para adicionar este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS допускает ограниченное число одновременных будильников. Отключите один, чтобы добавить этот."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 同时允许的闹钟数量有限。请先关闭一个再添加。"
          }
        }
      }
    },
