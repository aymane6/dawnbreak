    "mission.steps.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the iPhone with you while you walk."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احمل الـ iPhone معك أثناء المشي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm das iPhone beim Gehen mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el iPhone contigo mientras caminas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez l’iPhone sur vous en marchant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलते समय iPhone अपने साथ रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta l’iPhone con te mentre cammini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩くときは iPhone を持っていてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸을 때 iPhone을 몸에 지니세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o iPhone com você enquanto caminha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите iPhone при себе, когда идёте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走动时把 iPhone 带在身上。"
          }
        }
      }
    },
    "mission.steps.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get out of bed and walk until the steps are counted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انزل من السرير وامشِ حتى تُحتسب الخطوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf und gehe, bis die Schritte gezählt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levántate y camina hasta completar los pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levez-vous et marchez jusqu’à ce que les pas soient comptés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिस्तर से उठें और कदम पूरे होने तक चलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati e cammina finché i passi non sono contati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベッドから出て、歩数が満たされるまで歩きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침대에서 나와 걸음 수가 채워질 때까지 걸으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante e caminhe até os passos serem contados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встаньте и идите, пока шаги не будут засчитаны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下床走动，直到步数达标。"
          }
        }
      }
    },
