    "typing.sentence.short.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up before thinking twice."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قف قبل أن تفكّر مرتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf, bevor du nachdenkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte en pie antes de pensarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levez-vous avant d’y réfléchir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा सोचने से पहले खड़े हो जाइए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati prima di ripensarci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考える前に立ち上がれ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 생각하기 전에 일어서라."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique de pé antes de pensar duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань, пока не начал думать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别再想，先站起来。"
          }
        }
      }
    },
