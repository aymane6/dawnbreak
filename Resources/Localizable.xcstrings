    "mission.draw.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw what the screen asks for, well enough to be recognised."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم ما تطلبه الشاشة بشكل يمكن التعرّف عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne erkennbar, was der Bildschirm verlangt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja lo que pide la pantalla, de forma reconocible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez ce que l’écran demande, de façon reconnaissable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन जो कहे वह बनाएँ, इतना साफ़ कि पहचाना जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna ciò che chiede lo schermo, in modo riconoscibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のお題を、認識できる程度に描きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 요구하는 것을 알아볼 수 있게 그리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe o que a tela pedir, de forma reconhecível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте то, что просит экран, узнаваемо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画出屏幕给的题目，画到能被认出为止。"
