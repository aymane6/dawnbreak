    "onboarding.permission.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics, nothing leaves your iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب، لا تحليلات، ولا شيء يخرج من الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Analytics, nichts verlässt dein iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin analíticas, nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte, aucune analytique, rien ne quitte votre iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अकाउंट नहीं, कोई एनालिटिक्स नहीं, कुछ भी आपके iPhone से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna analitica, niente lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし、解析なし、iPhone の外へは何も出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없음, 분석 없음, 어떤 것도 iPhone을 떠나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem analytics, nada sai do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта, без аналитики, ничего не покидает ваш iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，没有分析追踪，任何数据都不会离开你的 iPhone。"
          }
        }
      }
    },
    "onboarding.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One permission, and it is the important one"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن واحد، وهو الأهم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Berechtigung — und zwar die entscheidende"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso, y es el importante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation, et c’est la plus importante"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अनुमति, और वही सबसे ज़रूरी है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permesso, ed è quello che conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可は 1 つ。そして最も重要なものです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한은 하나, 그리고 가장 중요한 것"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma permissão, e é a importante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно разрешение, и оно главное"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需一个权限，而且是最关键的那个"
          }
        }
      }
    },
    "onboarding.promise.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak rings, and then it asks you to prove you are awake."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن Dawnbreak، ثم يطلب منك إثبات أنك مستيقظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak klingelt — und verlangt dann den Beweis, dass du wach bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak suena y después te pide que demuestres que estás despierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak sonne, puis vous demande de prouver que vous êtes réveillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak बजता है, और फिर साबित करने को कहता है कि आप जाग गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak suona, poi ti chiede di dimostrare che sei sveglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak は鳴り、そして起きた証拠を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak는 울린 다음, 당신이 깨어 있다는 증거를 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak toca e depois pede que você prove que está acordado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak звонит, а потом требует доказать, что вы проснулись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak 会响，然后要求你证明自己真的醒了。"
          }
        }
      }
    },
    "onboarding.promise.focus": {
