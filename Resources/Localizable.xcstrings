        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está a três frases do resto da sua vida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От остатка твоей жизни тебя отделяют три фразы."
