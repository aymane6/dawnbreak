    "onboarding.permission.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow alarms"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالمنبهات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarme erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir alarmas"
          }
        },
        "fr": {
          "stringUnit": {
