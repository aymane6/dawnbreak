          "stringUnit": {
            "state": "translated",
            "value": "Tageslicht schlägt jeden Alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La luz del día gana a cualquier alarma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lumière du jour vaut mieux qu’une alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन की रोशनी हर अलार्म से बेहतर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La luce del giorno batte ogni sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日の光はどんなアラームにも勝る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "햇빛은 어떤 알람보다 낫다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A luz do dia vence qualquer alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневной свет лучше будильника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日光胜过任何闹钟。"
          }
        }
      }
    },
    "typing.sentence.short.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cold water wakes the face."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الماء البارد يوقظ الوجه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaltes Wasser weckt das Gesicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agua fría despierta la cara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eau froide réveille le visage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठंडा पानी चेहरे को जगा देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acqua fredda sveglia il viso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷たい水が顔を起こす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬물이 얼굴을 깨운다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água fria acorda o rosto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холодная вода будит лицо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冷水能唤醒一张脸。"
          }
        }
      }
    },
    "typing.sentence.short.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody regrets rising early."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يندم على الاستيقاظ مبكراً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand bedauert frühes Aufstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie se arrepiente de madrugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne regrette de se lever tôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल्दी उठने का पछतावा किसी को नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno rimpiange di alzarsi presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早起きを悔やむ人はいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어난 걸 후회하는 사람은 없다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém se arrepende de acordar cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не жалеет, что встал рано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人后悔早起。"
          }
        }
      }
    },
    "typing.sentence.short.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bed is a trap."
          }
        },
        "ar": {
