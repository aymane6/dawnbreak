    "mission.physicalCaution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one asks for movement. Do only what feels safe; the cross in the top corner ends the mission at any time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المهمة تطلب حركة. افعل ما تشعر أنه آمن فقط؛ وعلامة × في الزاوية العليا تُنهي المهمة في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese verlangt Bewegung. Mach nur, was sich sicher anfühlt; das Kreuz oben in der Ecke beendet die Mission jederzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pide movimiento. Haz solo lo que sientas seguro; la cruz de la esquina superior termina la misión en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celle-ci demande de bouger. Ne faites que ce qui vous paraît sûr : la croix dans le coin supérieur met fin à la mission à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हिलने-डुलने की माँग करती है। वही करें जो सुरक्षित लगे; ऊपरी कोने का क्रॉस मिशन को कभी भी ख़त्म कर देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiede movimento. Fai solo ciò che ti sembra sicuro; la croce nell’angolo in alto chiude la missione in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは体を動かすミッションです。安全だと思える範囲だけにしてください。上隅の×でいつでもミッションを終えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미션은 몸을 움직여야 합니다. 안전하다고 느끼는 만큼만 하세요. 위쪽 모서리의 ×로 언제든 미션을 끝낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pede movimento. Faça só o que parecer seguro; a cruz no canto de cima encerra a missão a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это задание требует движения. Делайте только то, что кажется безопасным; крестик в верхнем углу завершает задание в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务需要活动身体。只做你觉得安全的部分；上方角落的叉随时可以结束任务。"
          }
        }
      }
    },
