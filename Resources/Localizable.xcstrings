    "stats.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your first morning with Dawnbreak, this screen tells you the truth about how you wake up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد أول صباح لك مع Dawnbreak، ستقول لك هذه الشاشة الحقيقة عن طريقة استيقاظك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem ersten Morgen mit Dawnbreak sagt dir dieser Bildschirm die Wahrheit über dein Aufwachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de tu primera mañana con Dawnbreak, esta pantalla te dirá la verdad sobre cómo te despiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre premier matin avec Dawnbreak, cet écran vous dira la vérité sur vos réveils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak के साथ आपकी पहली सुबह के बाद, यह स्क्रीन बताएगी कि आप असल में कैसे जागते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la prima mattina con Dawnbreak, questa schermata ti dirà la verità su come ti svegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak と過ごす最初の朝が終われば、この画面はあなたの起き方について本当のことを教えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak와 함께한 첫 아침이 지나면, 이 화면이 당신의 기상에 대한 진실을 알려줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da sua primeira manhã com o Dawnbreak, esta tela vai te contar a verdade sobre como você acorda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После первого утра с Dawnbreak этот экран расскажет правду о том, как вы просыпаетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你与 Dawnbreak 度过第一个早晨之后，这个页面会告诉你关于起床的真相。"
          }
        }
      }
    },
