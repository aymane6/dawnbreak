          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого задания нужна камера. Разрешите её в настройках или пропустите задание на этот раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
