        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 알람이 모두 꺼져 있습니다. 아무것도 울리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os alarmes abaixo estão desligados. Nada vai tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все будильники ниже отключены. Ничего не прозвонит."
