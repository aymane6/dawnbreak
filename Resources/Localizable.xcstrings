    "editor.relentless.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the mission is not finished, the alarm comes back a minute later. Again and again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تُنجز المهمة، يعود المنبه بعد دقيقة. مرة بعد مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist die Mission nicht erledigt, kommt der Alarm eine Minute später zurück. Wieder und wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no terminas la misión, la alarma vuelve un minuto después. Una y otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la mission n’est pas terminée, l’alarme revient une minute plus tard. Encore et encore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर मिशन पूरा नहीं हुआ, तो अलार्म एक मिनट बाद फिर बजेगा। बार-बार।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la missione non è completata, la sveglia torna un minuto dopo. Di nuovo e di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッションが終わっていなければ、1 分後にアラームが戻ってきます。何度でも。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션을 끝내지 않으면 1분 뒤 알람이 다시 울립니다. 계속해서."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a missão não terminar, o alarme volta um minuto depois. Sempre de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если задание не выполнено, будильник вернётся через минуту. И снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务没完成，闹钟一分钟后就会回来。一次又一次。"
          }
        }
      }
    },
