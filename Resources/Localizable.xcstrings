            "state": "translated",
            "value": "Folge dem Kreis: einatmen, halten, ausatmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el círculo: inspira, aguanta, espira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le cercle : inspirez, retenez, expirez."
