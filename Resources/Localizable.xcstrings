    "mission.breathe.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the circle: breathe in, hold, breathe out."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع الدائرة: شهيق، حبس، زفير."
