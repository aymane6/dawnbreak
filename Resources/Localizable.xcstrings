          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui il cerchio: inspira, trattieni, espira."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円に合わせて、吸って、止めて、吐きます。"
