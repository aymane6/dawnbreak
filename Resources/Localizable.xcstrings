    "enroll.barcode.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a barcode you keep far from the bed: the toothpaste, the coffee bag, a cereal box. That exact code is the only one that will stop the alarm."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح باركود شيء تحفظه بعيداً عن السرير: معجون الأسنان، كيس القهوة، علبة الحبوب. هذا الرمز بالذات هو ما سيوقف المنبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne einen Barcode, der weit vom Bett liegt: Zahnpasta, Kaffeepackung, Müslischachtel. Nur genau dieser Code stoppt den Alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código de algo que guardas lejos de la cama: la pasta de dientes, el café, una caja de cereales. Solo ese código exacto parará la alarma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code-barres d’un objet rangé loin du lit : le dentifrice, le paquet de café, une boîte de céréales. Seul ce code précis arrêtera l’alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ऐसी चीज़ का बारकोड स्कैन करें जो बिस्तर से दूर रहती है: टूथपेस्ट, कॉफ़ी का पैकेट, सीरियल का डिब्बा। ठीक वही कोड अलार्म रोकेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice di qualcosa che tieni lontano dal letto: il dentifricio, il caffè, una scatola di cereali. Solo quel codice esatto fermerà la sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベッドから遠い場所に置いているモノのバーコードを読み取ってください。歯みがき粉、コーヒーの袋、シリアルの箱など。そのコードだけがアラームを止めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침대에서 먼 곳에 두는 물건의 바코드를 스캔하세요. 치약, 커피 봉지, 시리얼 상자 같은 것. 정확히 그 코드만 알람을 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código de algo que fica longe da cama: a pasta de dente, o pacote de café, uma caixa de cereal. Só aquele código exato vai parar o alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте штрих-код того, что лежит далеко от кровати: зубной паста, пачка кофе, коробка хлопьев. Только этот код выключит будильник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描一件放得离床很远的东西的条码：牙膏、咖啡袋、麦片盒。只有这一个条码能关掉闹钟。"
          }
        }
      }
    },
