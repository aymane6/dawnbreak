    "enroll.camera.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registering needs the camera. Allow it in Settings and come back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل يحتاج إلى الكاميرا. اسمح بها من الإعدادات ثم عد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Registrieren wird die Kamera gebraucht. Erlaube sie in den Einstellungen und komm zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar necesita la cámara. Permítela en Ajustes y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement a besoin de la caméra. Autorisez-la dans Réglages puis revenez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रजिस्टर करने के लिए कैमरा चाहिए। सेटिंग में अनुमति देकर लौटें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione richiede la fotocamera. Consentila in Impostazioni e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録にはカメラが必要です。設定で許可してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록에는 카메라가 필요합니다. 설정에서 허용한 뒤 돌아오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar precisa da câmera. Permita em Ajustes e volte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для регистрации нужна камера. Разрешите её в настройках и вернитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登记需要相机。请在“设置”中允许后再回来。"
          }
        }
      }
    },
