    "mission.shake.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake your iPhone until the counter fills."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رجّ الـ iPhone حتى يمتلئ العدّاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttle dein iPhone, bis der Zähler voll ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agita el iPhone hasta llenar el contador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secouez votre iPhone jusqu’à remplir le compteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काउंटर भरने तक iPhone हिलाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuoti l’iPhone finché il contatore non è pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウンターが埋まるまで iPhone を振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운터가 채워질 때까지 iPhone을 흔드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agite o iPhone até o contador encher."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трясите iPhone, пока счётчик не заполнится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇动 iPhone 直到计数满。"
          }
        }
      }
    },
