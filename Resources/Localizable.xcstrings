    },
    "paywall.feature.missions.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to the kettle and photograph it, scan a barcode, do squats on camera, draw what you are told. Free keeps three."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امشِ إلى الغلاية وصوّرها، امسح باركود، اسجد قرفصاء أمام الكاميرا، ارسم ما يُطلب منك. المجاني يمنحك ثلاث مهام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Wasserkocher gehen und ihn fotografieren, Barcode scannen, Kniebeugen vor der Kamera, auf Kommando zeichnen. Gratis bleiben drei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve hasta la tetera y fotografíala, escanea un código, haz sentadillas ante la cámara, dibuja lo que te pidan. Gratis te deja tres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller jusqu’à la bouilloire et la photographier, scanner un code-barres, faire des squats face caméra, dessiner à la demande. La version gratuite en garde trois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केतली तक जाकर फ़ोटो लें, बारकोड स्कैन करें, कैमरे के सामने स्क्वैट करें, जो कहा जाए वह बनाएँ। मुफ़्त में तीन मिशन मिलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai fino al bollitore e fotografalo, scansiona un codice, fai squat davanti alla fotocamera, disegna a comando. La versione gratuita ne tiene tre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケトルまで歩いて撮影、バーコードを読み取り、カメラの前でスクワット、指示どおりに描く。無料版は 3 つまで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주전자까지 걸어가 사진을 찍고, 바코드를 스캔하고, 카메라 앞에서 스쿼트하고, 지시대로 그리세요. 무료에서는 세 가지만."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vá até a chaleira e fotografe, escaneie um código, faça agachamentos na câmera, desenhe o que mandarem. O grátis fica com três."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дойти до чайника и сфотографировать его, отсканировать штрих-код, приседать перед камерой, нарисовать, что скажут. В бесплатной версии — три задания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走到水壶前拍下它、扫描条码、在镜头前深蹲、照要求画画。免费版保留三种。"
          }
        }
      }
    },
