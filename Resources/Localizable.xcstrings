          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작 접근이 꺼져 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao movimento está desativado"
          }
        },
        "ru": {
