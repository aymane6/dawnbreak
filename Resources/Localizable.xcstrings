        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬물이 얼굴을 깨운다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Água fria acorda o rosto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холодная вода будит лицо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冷水能唤醒一张脸。"
          }
        }
      }
    },
    "typing.sentence.short.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody regrets rising early."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يندم على الاستيقاظ مبكراً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand bedauert frühes Aufstehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie se arrepiente de madrugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne regrette de se lever tôt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल्दी उठने का पछतावा किसी को नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno rimpiange di alzarsi presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早起きを悔やむ人はいない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어난 걸 후회하는 사람은 없다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém se arrepende de acordar cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не жалеет, что встал рано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人后悔早起。"
          }
        }
      }
    },
    "typing.sentence.short.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bed is a trap."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سريرك فخّ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bett ist eine Falle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cama es una trampa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre lit est un piège."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बिस्तर एक जाल है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo letto è una trappola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベッドは罠だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침대는 함정이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cama é uma armadilha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя кровать — это ловушка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的床是个陷阱。"
          }
        }
      }
    },
    "typing.sentence.short.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up before thinking twice."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قف قبل أن تفكّر مرتين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steh auf, bevor du nachdenkst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte en pie antes de pensarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Levez-vous avant d’y réfléchir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा सोचने से पहले खड़े हो जाइए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzati prima di ripensarci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考える前に立ち上がれ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 생각하기 전에 일어서라."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique de pé antes de pensar duas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встань, пока не начал думать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "别再想，先站起来。"
          }
        }
      }
    },
