    "paywall.feature.alarms.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekdays, the gym, the flight, the exam. Free gives you one."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أيام العمل، النادي، الرحلة، الامتحان. المجاني يمنحك منبهاً واحداً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochentage, Sport, Flug, Prüfung. Gratis gibt es einen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días de semana, el gimnasio, el vuelo, el examen. Gratis te da una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine, le sport, l’avion, l’examen. La version gratuite en donne une."
          }
