    "alarms.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the time, pick what you will have to do to stop it, and go to bed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط الوقت، اختر ما ستفعله لإيقافه، وانم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit einstellen, festlegen, was du zum Stoppen tun musst, und ins Bett."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la hora, elige qué tendrás que hacer para pararla y vete a la cama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez l’heure, choisissez ce qu’il faudra faire pour l’arrêter, et allez dormir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय सेट करें, तय करें कि रोकने के लिए क्या करना होगा, और सो जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l’ora, scegli cosa dovrai fare per fermarla e vai a dormire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻を決め、止めるために何をするかを選んで、寝てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 정하고, 알람을 끄기 위해 할 일을 고른 뒤 잠자리에 드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina a hora, escolha o que você terá que fazer para parar e vá dormir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте время, выберите, что придётся сделать, чтобы его выключить, и ложитесь спать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定时间，选好你必须做什么才能关掉它，然后去睡。"
          }
        }
      }
    },
