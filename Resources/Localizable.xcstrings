    "settings.escapeHatch.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you give up on a mission and stop the alarm. On, because an app that can trap you in a squat count at 06:00 is worse than one you can cheat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح لك بالتخلي عن مهمة وإيقاف المنبه. مُفعّل، لأن تطبيقاً قادراً على حبسك في عدّ القرفصاء في السادسة صباحاً أسوأ من تطبيق يمكن الغش فيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt, eine Mission aufzugeben und den Alarm zu stoppen. Standardmäßig an: eine App, die dich um 6 Uhr in Kniebeugen gefangen hält, ist schlimmer als eine, die man betrügen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite rendirte en una misión y parar la alarma. Activado, porque una app que puede atraparte contando sentadillas a las 6:00 es peor que una en la que puedes hacer trampa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet d’abandonner une mission et d’arrêter l’alarme. Activé, car une app qui peut vous enfermer dans des squats à 6 h est pire qu’une app où l’on peut tricher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपको मिशन छोड़कर अलार्म बंद करने देता है। चालू, क्योंकि सुबह 6 बजे स्क्वैट गिनती में फँसा देने वाला ऐप उससे बुरा है जिसमें चीटिंग हो सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti permette di arrenderti in una missione e fermare la sveglia. Attivo, perché un’app che può intrappolarti a contare squat alle 6:00 è peggio di una in cui puoi barare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッションをあきらめてアラームを止められます。既定でオン。朝 6 時にスクワットの数え上げから抜け出せないアプリは、ズルできるアプリより悪いからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션을 포기하고 알람을 끌 수 있게 합니다. 기본값은 켜짐. 아침 6시에 스쿼트 카운트에 갇히는 앱은 속일 수 있는 앱보다 나쁩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite desistir de uma missão e parar o alarme. Ativado, porque um app que pode te prender contando agachamentos às 6:00 é pior que um em que se pode trapacear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет отказаться от задания и выключить будильник. Включено: приложение, способное запереть вас в подсчёте приседаний в 6:00, хуже того, которое можно обмануть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许你放弃任务并停止闹钟。默认开启：一个能在早上六点把你困在数深蹲里的应用，比一个可以作弊的应用更糟。"
          }
        }
      }
    },
