    "mission.math.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve each problem. A wrong answer starts the round again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب عن كل عملية. الإجابة الخاطئة تُعيد الجولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löse jede Aufgabe. Eine falsche Antwort startet die Runde neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve cada cuenta. Un error reinicia la ronda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez chaque calcul. Une erreur relance la manche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सवाल का जवाब दें। गलत जवाब पर राउंड फिर शुरू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi ogni calcolo. Una risposta sbagliata ricomincia il turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各問に答えてください。間違えるとそのラウンドは最初から。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 문제에 답하세요. 틀리면 라운드가 처음부터 다시 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda cada conta. Um erro reinicia a rodada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите каждый пример. Ошибка начинает раунд заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答每道题。答错则本轮重新开始。"
