    "enroll.name.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what the alarm will ask for at 06:00, so name it the way you would say it out loud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ما سيطلبه المنبه في السادسة صباحاً، فسمّه كما تقوله بصوت عالٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach fragt der Alarm um 6 Uhr — nenne es so, wie du es aussprechen würdest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es lo que la alarma pedirá a las 6:00, así que llámalo como lo dirías en voz alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ce que l’alarme réclamera à 6 h : nommez-le comme vous le diriez à voix haute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यही अलार्म सुबह 6 बजे माँगेगा, तो इसे वैसा नाम दें जैसा आप बोलकर कहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È quello che la sveglia chiederà alle 6:00, quindi chiamalo come lo diresti a voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝 6 時にアラームが求めるのはこれです。口に出して呼ぶとおりの名前にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침 6시에 알람이 요구할 이름입니다. 소리 내어 부르는 대로 적으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É isso que o alarme vai pedir às 6:00, então dê o nome que você usaria em voz alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Именно это будильник потребует в 6:00, поэтому назовите так, как сказали бы вслух."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是早上六点闹钟会向你要的东西，用你平时口头会说的叫法命名。"
          }
        }
      }
    },
