    "mission.squats.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand your iPhone up, get in frame, and do the squats."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسند الـ iPhone، ادخل في الإطار، وقم بتمارين القرفصاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle dein iPhone auf, komm ins Bild und mach die Kniebeugen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya el iPhone, ponte en el encuadre y haz las sentadillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez votre iPhone, cadrez-vous et faites les squats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone खड़ा करें, फ्रेम में आएँ और स्क्वैट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia l’iPhone, inquadrati e fai gli squat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を立てて、画面に全身を入れてスクワットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 세우고 화면에 몸을 맞춘 뒤 스쿼트를 하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie o iPhone, apareça no quadro e faça os agachamentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте iPhone, попадите в кадр и приседайте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 iPhone 立起来，站进取景框，开始深蹲。"
          }
        }
      }
    },
