    "onboarding.missions.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve sums, walk a hundred steps, do squats on camera, photograph the kettle. Choose per alarm, and choose how hard."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّ عمليات حسابية، امشِ مئة خطوة، قم بتمارين القرفصاء أمام الكاميرا، صوّر الغلاية. اختر لكل منبه، واختر مدى الصعوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen, hundert Schritte gehen, Kniebeugen vor der Kamera, den Wasserkocher fotografieren. Pro Alarm wählbar, inklusive Schwierigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelve cuentas, camina cien pasos, haz sentadillas ante la cámara, fotografía la tetera. Eliges por alarma, y eliges lo difícil que es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolvez des calculs, marchez cent pas, faites des squats face caméra, photographiez la bouilloire. À choisir pour chaque alarme, difficulté comprise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सवाल हल करें, सौ कदम चलें, कैमरे के सामने स्क्वैट करें, केतली की फ़ोटो लें। हर अलार्म के लिए चुनें, और कठिनाई भी चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risolvi calcoli, cammina cento passi, fai squat davanti alla fotocamera, fotografa il bollitore. Scegli per ogni sveglia, e scegli quanto difficile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算を解く、100歩歩く、カメラの前でスクワット、ケトルを撮影。アラームごとに、難易度まで選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산을 풀고, 백 걸음을 걷고, 카메라 앞에서 스쿼트하고, 주전자를 찍으세요. 알람마다, 난이도까지 고를 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva contas, caminhe cem passos, faça agachamentos na câmera, fotografe a chaleira. Você escolhe por alarme, e escolhe o quanto é difícil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решайте примеры, пройдите сто шагов, приседайте перед камерой, сфотографируйте чайник. Выбор для каждого будильника, вместе со сложностью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做算术、走一百步、在镜头前深蹲、拍下水壶。每个闹钟单独选，难度也由你定。"
          }
        }
      }
    },
