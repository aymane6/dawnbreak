    "editor.chain.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you clear the mission, the alarm rings again with the next one. Only clearing the last one ends the morning."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إنجاز المهمة يرن المنبه مجدداً بالمهمة التالية. إنجاز الأخيرة وحده يُنهي الصباح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der gelösten Mission klingelt der Alarm erneut mit der nächsten. Erst die letzte beendet den Morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al superar la misión, la alarma vuelve a sonar con la siguiente. Solo la última termina la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la mission réussie, l’alarme resonne avec la suivante. Seule la dernière met fin à la matinée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिशन पूरा करने पर अलार्म अगले मिशन के साथ फिर बजता है। सुबह आख़िरी मिशन से ही खत्म होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Superata la missione, la sveglia suona di nuovo con la successiva. Solo l’ultima chiude la mattina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッションをクリアすると、次のミッションでもう一度鳴ります。朝が終わるのは最後の1つをクリアしたときだけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션을 끝내면 다음 미션과 함께 알람이 다시 울립니다. 마지막 미션을 끝내야 아침이 끝납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao concluir a missão, o alarme toca de novo com a próxima. Só a última encerra a manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните задание — будильник зазвонит снова со следующим. Утро заканчивается только на последнем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成任务后，闹钟会带着下一个任务再次响起。只有完成最后一个，早晨才算结束。"
          }
        }
      }
    },
