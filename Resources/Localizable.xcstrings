    "alarms.noneArmedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every alarm below is switched off. Nothing will ring."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل المنبهات أدناه مُطفأة. لن يرن شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
