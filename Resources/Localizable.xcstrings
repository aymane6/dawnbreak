    "mission.rehearsal.done.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is what this alarm will ask of you. Nothing was armed or recorded."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ما سيطلبه منك هذا المنبه. لم يُضبط أو يُسجَّل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verlangt dieser Alarm von dir. Nichts wurde gestellt oder gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es lo que te pedirá esta alarma. No se ha armado ni registrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voilà ce que cette alarme vous demandera. Rien n’a été armé ni enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अलार्म आपसे यही माँगेगा। कुछ भी सेट या दर्ज नहीं हुआ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco cosa ti chiederà questa sveglia. Niente è stato attivato o registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアラームではこれが求められます。アラームの設定や記録は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알람은 이 미션을 요구합니다. 아무것도 설정되거나 기록되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É isso que este alarme vai pedir. Nada foi armado nem registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Именно это попросит будильник. Ничего не заведено и не записано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是这个闹钟会要求你做的。没有设置闹钟，也没有记录。"
          }
        }
      }
    },
