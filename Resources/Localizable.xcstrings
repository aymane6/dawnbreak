          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4 回目のスヌーズから、良いことが生まれた例はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 번째 다시 알림에서 좋은 일이 생긴 적은 없다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca saiu nada bom da quarta soneca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из четвёртого нажатия «отложить» ещё ничего хорошего не выходило."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第四次按下小睡，从没带来什么好事。"
