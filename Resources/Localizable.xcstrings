    "paywall.cta.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel any time in the App Store. A lifetime purchase is not a subscription and never renews."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإلغاء في أي وقت من App Store. الشراء الدائم ليس اشتراكاً ولا يُجدَّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jederzeit im App Store kündbar. Ein Einmalkauf ist kein Abo und verlängert sich nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras en la App Store. La compra para siempre no es una suscripción y nunca se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulable à tout moment dans l’App Store. L’achat à vie n’est pas un abonnement et ne se renouvelle jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store में कभी भी रद्द करें। लाइफ़टाइम खरीद सब्सक्रिप्शन नहीं है और कभी रिन्यू नहीं होती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare quando vuoi nell’App Store. L’acquisto a vita non è un abbonamento e non si rinnova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store でいつでも解約できます。買い切りはサブスクリプションではなく、更新されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 언제든 해지할 수 있습니다. 평생 구매는 구독이 아니며 갱신되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser na App Store. A compra vitalícia não é assinatura e nunca renova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить можно в любой момент в App Store. Пожизненная покупка не подписка и не продлевается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可随时在 App Store 取消。终身购买不是订阅，永不自动续费。"
          }
        }
      }
    },
