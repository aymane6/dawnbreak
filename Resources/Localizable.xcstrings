    "mission.sequence.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the pattern, then repeat it in the same order."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد النمط ثم أعده بالترتيب نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh das Muster und wiederhole es in derselben Reihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa el patrón y repítelo en el mismo orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez le motif, puis répétez-le dans le même ordre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैटर्न देखें, फिर उसी क्रम में दोहराएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva la sequenza, poi ripetila nello stesso ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パターンを見て、同じ順番で再現します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴을 본 뒤 같은 순서로 따라 하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe o padrão e repita na mesma ordem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите рисунок и повторите его в том же порядке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看清图案，再按相同顺序重复。"
          }
        }
      }
    },
