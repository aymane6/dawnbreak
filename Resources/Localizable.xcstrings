    "mission.exit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm stops and the morning is logged as a bail-out. You are the one who has to be somewhere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف المنبه وسيُسجّل الصباح كانسحاب. أنت من عليه أن يكون في مكان ما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alarm verstummt und der Morgen wird als Abbruch protokolliert. Du bist der, der irgendwo sein muss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alarma se para y la mañana queda registrada como abandono. Tú eres quien tiene que estar en algún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alarme s’arrête et la matinée est notée comme un abandon. C’est vous qui devez être quelque part."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म बंद हो जाएगा और यह सुबह छोड़ने के रूप में दर्ज होगी। कहीं पहुँचना आपको ही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sveglia si ferma e la mattina viene registrata come resa. Sei tu quello che deve essere da qualche parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームは止まり、この朝は「途中でやめた」として記録されます。どこかへ行かなければならないのはあなたです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 멈추고 이 아침은 포기로 기록됩니다. 어딘가에 가야 하는 사람은 당신입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme para e a manhã fica registrada como desistência. Quem precisa estar em algum lugar é você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник выключится, а утро запишется как отказ. Это вам нужно куда-то успеть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟会停止，这个早晨会记为放弃。要赶去某处的人是你。"
          }
        }
      }
    },
