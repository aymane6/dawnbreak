            "value": "Votre lit est un piège."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बिस्तर एक जाल है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo letto è una trappola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベッドは罠だ。"
          }
        },
        "ko": {
          "stringUnit": {
