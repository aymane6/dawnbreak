            "value": "सभी बारह मिशन"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le dodici missioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 のミッションすべて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열두 가지 미션 전부"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as doze missões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все двенадцать заданий"
          }
        },
        "zh-Hans": {
