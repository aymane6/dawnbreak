    "onboarding.permission.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak uses the alarm system built into iOS, so it can ring in silent mode and during Focus, even with the app closed. You can change this at any time in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Dawnbreak نظام المنبهات المدمج في iOS، لذا يمكنه أن يرن في الوضع الصامت وأثناء التركيز، حتى والتطبيق مغلق. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak nutzt das in iOS eingebaute Alarmsystem. So kann es trotz Stummschaltung und Fokus klingeln, auch wenn die App geschlossen ist. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak usa el sistema de alarmas integrado en iOS, así que puede sonar en modo silencio y con un modo de concentración activo, incluso con la app cerrada. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak utilise le système d’alarmes intégré à iOS : il peut sonner en mode silencieux et pendant une concentration, même app fermée. Vous pourrez changer ce choix à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak iOS में बने अलार्म सिस्टम का इस्तेमाल करता है, इसलिए यह साइलेंट मोड और फ़ोकस में भी बज सकता है, ऐप बंद होने पर भी। आप इसे कभी भी सेटिंग में बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak usa il sistema di sveglie integrato in iOS, quindi può suonare in modalità silenziosa e con Full Immersion attiva, anche ad app chiusa. Puoi cambiare questa scelta quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak は iOS に組み込まれたアラーム機能を使うため、サイレントモードや集中モード中でも、アプリを閉じていても鳴らせます。この設定は「設定」でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak는 iOS에 내장된 알람 시스템을 사용하므로 무음 모드와 집중 모드에서도, 앱을 닫아 두어도 울릴 수 있습니다. 이 설정은 언제든 설정에서 바꿀 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak usa o sistema de alarmes do próprio iOS, então pode tocar no modo silencioso e com o Foco ativado, mesmo com o app fechado. Você pode mudar isso quando quiser em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak использует встроенную в iOS систему будильников, поэтому может звонить в беззвучном режиме и при фокусировании, даже когда приложение закрыто. Изменить это можно в любой момент в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak 使用 iOS 内置的闹钟系统，因此在静音模式和专注模式下都能响铃，即使应用已关闭。你可以随时在“设置”中更改。"
          }
        }
      }
    },
    "onboarding.permission.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denied. You can still look around, but no alarm will ring until you allow this in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الرفض. يمكنك التصفّح، لكن لن يرن أي منبه حتى تسمح بذلك من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verweigert. Du kannst dich umsehen, aber kein Alarm klingelt, bis du das in den Einstellungen erlaubst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Denegado. Puedes seguir mirando, pero ninguna alarma sonará hasta que lo permitas en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusé. Vous pouvez explorer, mais aucune alarme ne sonnera tant que vous ne l’autorisez pas dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मना कर दिया गया। आप देख सकते हैं, लेकिन जब तक सेटिंग में अनुमति नहीं देते, कोई अलार्म नहीं बजेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negato. Puoi dare un’occhiata, ma nessuna sveglia suonerà finché non lo consenti in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されました。中を見ることはできますが、設定で許可するまでアラームは鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거부되었습니다. 둘러볼 수는 있지만, 설정에서 허용하기 전까지 알람은 울리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Negado. Você pode olhar à vontade, mas nenhum alarme vai tocar até você permitir em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказано. Осмотреться можно, но ни один будильник не прозвонит, пока вы не разрешите это в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝。你可以随便看看，但在“设置”中允许之前，任何闹钟都不会响。"
          }
        }
      }
    },
    "onboarding.permission.granted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed. Dawnbreak can wake you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم السماح. يستطيع Dawnbreak إيقاظك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilt. Dawnbreak kann dich wecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedido. Dawnbreak puede despertarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé. Dawnbreak peut vous réveiller."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति मिल गई। Dawnbreak आपको जगा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concesso. Dawnbreak può svegliarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されました。Dawnbreak はあなたを起こせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되었습니다. Dawnbreak가 당신을 깨울 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido. O Dawnbreak pode te acordar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено. Dawnbreak сможет вас разбудить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许。Dawnbreak 可以叫醒你了。"
          }
        }
      }
    },
    "onboarding.permission.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics, nothing leaves your iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب، لا تحليلات، ولا شيء يخرج من الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Analytics, nichts verlässt dein iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin analíticas, nada sale de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte, aucune analytique, rien ne quitte votre iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अकाउंट नहीं, कोई एनालिटिक्स नहीं, कुछ भी आपके iPhone से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna analitica, niente lascia il tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし、解析なし、iPhone の外へは何も出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없음, 분석 없음, 어떤 것도 iPhone을 떠나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem analytics, nada sai do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта, без аналитики, ничего не покидает ваш iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，没有分析追踪，任何数据都不会离开你的 iPhone。"
          }
        }
      }
    },
