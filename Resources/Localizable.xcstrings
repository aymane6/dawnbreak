    "mission.steps.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone cannot count steps, so this mission has no way to finish."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذا الـ iPhone عدّ الخطوات، لذا لا سبيل لإكمال المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann keine Schritte zählen, diese Mission ist nicht abschließbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede contar pasos, así que esta misión no puede completarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas compter les pas : cette mission n’a aucun moyen d’aboutir."
