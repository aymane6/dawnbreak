    "error.alarmPermissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm permission is off, so nothing you set here will ring."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن المنبه معطّل، لذا لن يرن أي شيء تضبطه هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Alarm-Berechtigung ist aus — nichts, was du hier einstellst, klingelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de alarmas está desactivado: nada de lo que configures aquí sonará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’alarme est désactivée : rien de ce que vous réglez ici ne sonnera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म की अनुमति बंद है, इसलिए यहाँ सेट किया कुछ भी नहीं बजेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il permesso per le sveglie è disattivato: niente di ciò che imposti qui suonerà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームの許可がオフです。ここで設定しても鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 권한이 꺼져 있어 여기서 설정한 것은 울리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de alarmes está desativada, então nada configurado aqui vai tocar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на будильники отключено — ничто из настроенного здесь не прозвонит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟权限已关闭，你在这里设置的任何内容都不会响。"
          }
        }
      }
    },
    "error.authorizationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak could not ask for alarm permission. Grant it in Settings instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Dawnbreak من طلب إذن المنبه. امنحه من الإعدادات بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak konnte die Alarm-Berechtigung nicht anfragen. Erteile sie stattdessen in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak no ha podido pedir el permiso de alarmas. Concédelo desde Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak n’a pas pu demander l’autorisation d’alarme. Accordez-la dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak अलार्म की अनुमति नहीं माँग सका। इसे सेटिंग से दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak non ha potuto chiedere il permesso per le sveglie. Concedilo da Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak はアラームの許可を要求できませんでした。設定から許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak가 알람 권한을 요청할 수 없었습니다. 설정에서 직접 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak não conseguiu pedir permissão de alarmes. Conceda em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak не смог запросить разрешение на будильники. Выдайте его в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak 无法请求闹钟权限。请改在“设置”中授予。"
          }
        }
      }
    },
    "error.missionNeedsSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mission needs something registered first. Open the alarm and finish setting it up."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المهمة إلى تسجيل شيء أولاً. افتح المنبه وأكمل إعداده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Mission muss zuerst etwas registriert werden. Öffne den Alarm und richte sie fertig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta misión necesita registrar algo antes. Abre la alarma y termina de configurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mission exige d’abord d’enregistrer quelque chose. Ouvrez l’alarme et terminez la configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मिशन के लिए पहले कुछ रजिस्टर करना ज़रूरी है। अलार्म खोलें और सेटअप पूरा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa missione richiede prima di registrare qualcosa. Apri la sveglia e completa la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このミッションには先に登録が必要です。アラームを開いて設定を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미션은 먼저 등록이 필요합니다. 알람을 열어 설정을 마치세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta missão precisa que algo seja registrado antes. Abra o alarme e conclua a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого задания сначала нужно кое-что зарегистрировать. Откройте будильник и завершите настройку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务需要先注册一样东西。请打开闹钟并完成设置。"
          }
        }
      }
    },
    "error.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This alarm could not be saved, so it will not survive closing the app. Free up some storage and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ هذا المنبه، لذا لن يبقى بعد إغلاق التطبيق. حرّر بعض المساحة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Alarm konnte nicht gespeichert werden und übersteht das Schließen der App nicht. Schaffe Speicherplatz und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar esta alarma, así que no sobrevivirá al cierre de la app. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette alarme n’a pas pu être enregistrée : elle ne survivra pas à la fermeture de l’app. Libérez de l’espace et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अलार्म सेव नहीं हो सका, इसलिए ऐप बंद करने पर यह चला जाएगा। कुछ जगह खाली करें और फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare questa sveglia: non sopravvivrà alla chiusura dell’app. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアラームを保存できませんでした。アプリを閉じると失われます。空き容量を作ってからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알람을 저장할 수 없어 앱을 닫으면 사라집니다. 저장 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar este alarme, então ele não vai sobreviver ao fechamento do app. Libere espaço e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить будильник — он не сохранится после закрытия приложения. Освободите место и попробуйте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存该闹钟，关闭应用后它会消失。请清理一些存储空间后重试。"
          }
        }
      }
    },
    "error.scheduleFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS refused to schedule this alarm. It is saved, but it will not ring until you fix this."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض iOS جدولة هذا المنبه. تم حفظه، لكنه لن يرن حتى تعالج المشكلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat diesen Alarm nicht angenommen. Er ist gespeichert, klingelt aber nicht, bis das behoben ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha rechazado programar esta alarma. Está guardada, pero no sonará hasta que lo soluciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS a refusé de programmer cette alarme. Elle est enregistrée, mais elle ne sonnera pas tant que ce n’est pas réglé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ने इस अलार्म को शेड्यूल करने से इनकार कर दिया। यह सेव है, लेकिन ठीक होने तक बजेगा नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ha rifiutato di programmare questa sveglia. È salvata, ma non suonerà finché non risolvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がこのアラームの登録を拒否しました。保存はされていますが、解決するまで鳴りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 이 알람 등록을 거부했습니다. 저장은 되었지만 해결하기 전까지는 울리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS recusou agendar este alarme. Ele está salvo, mas não vai tocar até você resolver isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS отказался запланировать этот будильник. Он сохранён, но не прозвонит, пока проблема не решена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 拒绝了该闹钟的排程。闹钟已保存，但在问题解决前不会响。"
          }
        }
      }
    },
