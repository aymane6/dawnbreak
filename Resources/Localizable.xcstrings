            "value": "Giorni feriali, palestra, volo, esame. La versione gratuita ne dà una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日、ジム、フライト、試験。無料版は 1 個です。"
