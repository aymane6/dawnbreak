    "settings.erase.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your streak, your stats and every logged morning go with it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سلسلتك وإحصاءاتك وكل صباح مسجّل ستذهب معها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serie, Statistiken und jeder protokollierte Morgen verschwinden mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu racha, tus datos y todas las mañanas registradas se irán con ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre série, vos statistiques et chaque matin enregistré partent avec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लगातार सीरीज़, आँकड़े और हर दर्ज सुबह इसके साथ चली जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua serie, le statistiche e ogni mattina registrata andranno perse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続記録、統計、記録したすべての朝が一緒に消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연속 기록, 통계, 기록된 모든 아침이 함께 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sequência, seus dados e todas as manhãs registradas vão embora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша серия, статистика и каждое записанное утро исчезнут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的连续天数、统计数据和每一个记录的早晨都会一并消失。"
          }
        }
      }
    },
