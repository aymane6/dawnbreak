    "enroll.photo.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick something in another room: the kettle, the bathroom tap, your shoes. In the morning you will have to walk to it and photograph it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر شيئاً في غرفة أخرى: الغلاية، حنفية الحمام، حذاؤك. في الصباح ستضطر للمشي إليه وتصويره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle etwas in einem anderen Raum: den Wasserkocher, den Badhahn, deine Schuhe. Morgens musst du hingehen und es fotografieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige algo de otra habitación: la tetera, el grifo del baño, tus zapatos. Por la mañana tendrás que ir hasta ahí y fotografiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un objet dans une autre pièce : la bouilloire, le robinet, vos chaussures. Au matin, il faudra y aller et le photographier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे कमरे की कोई चीज़ चुनें: केतली, बाथरूम का नल, आपके जूते। सुबह आपको वहाँ जाकर उसकी फ़ोटो लेनी होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli qualcosa in un’altra stanza: il bollitore, il rubinetto del bagno, le scarpe. Al mattino dovrai andarci e fotografarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の部屋にあるモノを選んでください。ケトル、洗面台の蛇口、靴など。朝はそこまで歩いて撮影することになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 방에 있는 것을 고르세요. 주전자, 욕실 수도꼭지, 신발 같은 것. 아침에 거기까지 걸어가 사진을 찍어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha algo em outro ambiente: a chaleira, a torneira do banheiro, seus sapatos. De manhã você terá que ir até lá e fotografar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите что-то в другой комнате: чайник, кран в ванной, ваши кроссовки. Утром придётся дойти туда и это сфотографировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一件在另一个房间的东西：水壶、洗手台龙头、你的鞋。早上你得走过去把它拍下来。"
          }
        }
      }
    },
    "enroll.photo.searching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at it and hold steady"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الكاميرا نحوه وثبّتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera darauf richten und ruhig halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta la cámara y mantenla quieta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez-le et gardez stable"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा उस पर रखें और स्थिर रखें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadralo e tieni fermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを向けて静止させてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 향하게 하고 가만히 두세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte a câmera e segure firme"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите камеру и держите ровно"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把相机对准它并保持稳定"
