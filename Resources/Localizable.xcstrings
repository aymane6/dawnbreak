    "paywall.feature.difficulty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigger sums, longer patterns, more repetitions, up to ten rounds. Set it past what you can fake half asleep."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات أكبر، أنماط أطول، تكرارات أكثر، حتى عشر جولات. اضبطها فوق ما يمكنك تمثيله نصف نائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Rechnungen, längere Muster, mehr Wiederholungen, bis zu zehn Runden. Stelle es höher, als du halb schlafend vortäuschen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas más grandes, patrones más largos, más repeticiones, hasta diez rondas. Ponlo más allá de lo que puedes fingir medio dormido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculs plus gros, séquences plus longues, plus de répétitions, jusqu’à dix manches. Réglez au-delà de ce que vous pouvez simuler à moitié endormi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़े सवाल, लंबे पैटर्न, ज़्यादा दोहराव, दस राउंड तक। उतना रखें जितना आप आधी नींद में नकल न कर सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcoli più grandi, sequenze più lunghe, più ripetizioni, fino a dieci turni. Imposta oltre ciò che puoi simulare mezzo addormentato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より大きな計算、より長いパターン、より多い回数、最大 10 ラウンド。半分寝たままでは誤魔化せない設定に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 큰 계산, 더 긴 패턴, 더 많은 반복, 최대 10라운드. 반쯤 잠든 상태로는 흉내 낼 수 없는 수준으로 올리세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas maiores, padrões mais longos, mais repetições, até dez rodadas. Coloque além do que você consegue fingir meio dormindo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примеры сложнее, последовательности длиннее, повторений больше, до десяти раундов. Поставьте выше того, что можно изобразить в полусне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更大的算式、更长的序列、更多的次数，最多十轮。设到半梦半醒时装不出来的程度。"
          }
        }
      }
    },
    "paywall.feature.missions": {
