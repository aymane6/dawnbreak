    "mission.shake.unavailable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone will not report motion, so the shake cannot be counted."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ iPhone لا يبلّغ عن الحركة، لذا لا يمكن عدّ الرجّات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone meldet keine Bewegung, das Schütteln lässt sich nicht zählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no informa del movimiento, así que no se pueden contar las sacudidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne remonte pas le mouvement : les secousses ne peuvent pas être comptées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone मोशन रिपोर्ट नहीं करता, इसलिए हिलाना गिना नहीं जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non riporta il movimento: le scosse non possono essere contate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone はモーションを報告しないため、シェイクを数えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 동작을 보고하지 않아 흔들기를 셀 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não informa movimento, então não é possível contar as sacudidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не сообщает о движении, поэтому встряхивания не считаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 不上报运动数据，无法统计摇动次数。"
          }
        }
      }
    },
