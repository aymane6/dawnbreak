    "settings.section.sleep.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local reminder, calculated back from your earliest alarm. Nothing is sent anywhere."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكير محلي، محسوب رجوعاً من أقرب منبه لديك. لا يُرسل شيء إلى أي مكان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lokale Erinnerung, zurückgerechnet von deinem frühesten Alarm. Nichts wird irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio local, calculado desde tu alarma más temprana. No se envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel local, calculé à partir de votre alarme la plus matinale. Rien n’est envoyé nulle part."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लोकल रिमाइंडर, आपके सबसे जल्दी वाले अलार्म से पीछे गिनकर। कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria locale, calcolato a partire dalla tua sveglia più mattutina. Niente viene inviato altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん早いアラームから逆算するローカル通知です。どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 이른 알람에서 거꾸로 계산한 로컬 알림입니다. 어디에도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete local, calculado a partir do seu alarme mais cedo. Nada é enviado a lugar algum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное напоминание, рассчитанное от самого раннего будильника. Никуда ничего не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是根据你最早的闹钟倒推的本地提醒，不会发送到任何地方。"
          }
        }
      }
    },
