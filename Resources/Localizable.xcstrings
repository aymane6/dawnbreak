    "mission.memory.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch which tiles light up, then tap those tiles."
          }
        },
        "ar": {
          "stringUnit": {
