    "onboarding.promise.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An alarm you cannot argue with"
          }
        },
        "ar": {
          "stringUnit": {
