    "settings.section.data.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wake log is stored on this iPhone and nowhere else. There is no account and no server to delete it from."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الاستيقاظ محفوظ على هذا الـ iPhone وحده. لا حساب ولا خادم لحذفه منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Weckprotokoll liegt nur auf diesem iPhone. Es gibt kein Konto und keinen Server, von dem man es löschen müsste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de despertares se guarda solo en este iPhone. No hay cuenta ni servidor de donde borrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal des réveils est stocké sur cet iPhone, et nulle part ailleurs. Il n’y a ni compte ni serveur à purger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेक लॉग सिर्फ़ इस iPhone पर रखा जाता है। इसे हटाने के लिए न कोई अकाउंट है, न सर्वर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il registro dei risvegli è salvato solo su questo iPhone. Non c’è nessun account né server da cui cancellarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床ログはこの iPhone にのみ保存されます。削除すべきアカウントもサーバーも存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 기록은 이 iPhone에만 저장됩니다. 삭제할 계정도, 서버도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de despertares fica só neste iPhone. Não há conta nem servidor de onde apagá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал пробуждений хранится только на этом iPhone. Нет ни аккаунта, ни сервера, откуда его удалять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床记录只保存在这台 iPhone 上。没有账号，也没有服务器需要清除。"
          }
        }
      }
    },
