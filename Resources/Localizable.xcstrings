    "alarm.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its mission setup goes with it. This cannot be undone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف معه إعداد مهمته. لا يمكن التراجع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Missionskonfiguration verschwindet mit. Das lässt sich nicht widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración de misión se irá con ella. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa configuration de mission part avec. C’est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका मिशन सेटअप भी चला जाएगा। इसे पलटा नहीं जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche la configurazione della missione andrà perduta. L’azione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッションの設定も一緒に消えます。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미션 설정도 함께 사라집니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração da missão vai com ele. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка задания удалится вместе с ним. Отменить нельзя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务设置会一并删除，且无法撤销。"
          }
        }
      }
    },
