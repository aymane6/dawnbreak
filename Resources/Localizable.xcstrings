    "onboarding.promise.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak rings, and then it asks you to prove you are awake."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرن Dawnbreak، ثم يطلب منك إثبات أنك مستيقظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak klingelt und verlangt dann den Beweis, dass du wach bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak suena y después te pide que demuestres que estás despierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak sonne, puis vous demande de prouver que vous êtes réveillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak बजता है, और फिर साबित करने को कहता है कि आप जाग गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak suona, poi ti chiede di dimostrare che sei sveglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak は鳴り、そして起きた証拠を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak는 울린 다음, 당신이 깨어 있다는 증거를 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak toca e depois pede que você prove que está acordado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak звонит, а потом требует доказать, что вы проснулись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak 会响，然后要求你证明自己真的醒了。"
          }
        }
      }
    },
