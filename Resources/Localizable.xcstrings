            "value": "統計"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计"
          }
        }
      }
    },
    "typing.sentence.epic.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The difference between who you are and who you want to be is what you do before eight in the morning."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفرق بين ما أنت عليه وما تريد أن تكونه هو ما تفعله قبل الثامنة صباحاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Unterschied zwischen dem, was du bist, und dem, was du sein willst, ist das, was du vor acht Uhr tust."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La diferencia entre quién eres y quién quieres ser es lo que haces antes de las ocho de la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La différence entre qui vous êtes et qui vous voulez être, c’est ce que vous faites avant huit heures du matin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो हैं और जो बनना चाहते हैं, उसके बीच का फ़र्क वही है जो आप सुबह आठ बजे से पहले करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La differenza tra chi sei e chi vuoi essere è ciò che fai prima delle otto del mattino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの自分と、なりたい自分の差は、朝 8 時までに何をするかで決まる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금의 당신과 되고 싶은 당신의 차이는 아침 여덟 시 전에 무엇을 하는지에 있다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A diferença entre quem você é e quem você quer ser é o que você faz antes das oito da manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разница между тем, кто ты есть, и тем, кем хочешь быть, — это то, что ты делаешь до восьми утра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是谁与你想成为谁之间的差别，就在于早上八点前你做了什么。"
          }
        }
      }
    },
    "typing.sentence.epic.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somewhere out there another person is already awake, already moving, and not thinking about you at all."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مكان ما هناك شخص آخر مستيقظ بالفعل، ويتحرّك بالفعل، ولا يفكّر فيك إطلاقاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Irgendwo da draußen ist jemand schon wach, schon in Bewegung, und denkt überhaupt nicht an dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En algún lugar otra persona ya está despierta, ya se mueve y no piensa en ti en absoluto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque part, quelqu’un d’autre est déjà réveillé, déjà en mouvement, et ne pense pas du tout à vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं कोई और पहले से जाग चुका है, चल भी रहा है, और आपके बारे में बिलकुल नहीं सोच रहा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qualche parte un’altra persona è già sveglia, già in movimento, e non pensa affatto a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこかで誰かがもう起きて、もう動きだして、あなたのことなど考えていない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어딘가에서 다른 누군가는 이미 깨어 움직이고 있고, 당신 생각은 전혀 하지 않는다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em algum lugar outra pessoa já está acordada, já em movimento, e não está pensando em você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где-то другой человек уже проснулся, уже двигается и вовсе не думает о тебе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此刻某处已有人醒来、已在行动，而且根本没在想你。"
          }
        }
      }
    },
    "typing.sentence.epic.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not remember this particular morning, but you will remember the year it belonged to."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتذكّر هذا الصباح بالذات، لكنك ستتذكّر السنة التي كان منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen einzelnen Morgen wirst du nicht erinnern, aber das Jahr, zu dem er gehörte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recordarás esta mañana en concreto, pero recordarás el año al que perteneció."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne vous souviendrez pas de ce matin précis, mais vous vous souviendrez de l’année à laquelle il appartenait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ख़ास सुबह आपको याद नहीं रहेगी, लेकिन वह साल याद रहेगा जिसका यह हिस्सा थी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ricorderai questa mattina in particolare, ma ricorderai l’anno a cui apparteneva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この朝そのものは覚えていないだろうが、この朝が属した一年は覚えている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 아침 자체는 기억나지 않겠지만, 이 아침이 속한 해는 기억할 것이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não vai lembrar desta manhã em particular, mas vai lembrar do ano a que ela pertenceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Именно это утро ты не запомнишь, но запомнишь год, к которому оно относилось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不会记得这个具体的早晨，但你会记得它属于的那一年。"
          }
        }
      }
    },
    "typing.sentence.epic.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting up is not a feeling you wait for; it is a decision you make while cold."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستيقاظ ليس شعوراً تنتظره، بل قراراً تتخذه وأنت تشعر بالبرد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufstehen ist kein Gefühl, auf das man wartet, sondern eine Entscheidung, die man frierend trifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantarse no es un sentimiento que esperas, es una decisión que tomas con frío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lever n’est pas un sentiment qu’on attend : c’est une décision qu’on prend en ayant froid."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठना कोई एहसास नहीं जिसका इंतज़ार किया जाए, यह ठंड में लिया गया फ़ैसला है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alzarsi non è una sensazione che aspetti: è una decisione che prendi al freddo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きることは待つべき気分ではなく、寒さの中で下す決断だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어남은 기다릴 감정이 아니라, 추운 채로 내리는 결정이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar não é um sentimento que você espera; é uma decisão que você toma com frio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подъём — это не чувство, которого ждут, а решение, которое принимают, замерзая."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床不是一种等来的感觉，而是在寒意里做出的决定。"
          }
        }
      }
    },
    "typing.sentence.epic.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every hour you take back from sleep is an hour nobody else can schedule a meeting in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ساعة تستعيدها من النوم هي ساعة لا يستطيع أحد أن يحجز فيها اجتماعاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stunde, die du dem Schlaf abringst, ist eine Stunde, in die niemand ein Meeting legen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora que le quitas al sueño es una hora en la que nadie puede ponerte una reunión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure reprise au sommeil est une heure où personne ne peut vous caler une réunion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नींद से छीना हर घंटा वह घंटा है जिसमें कोई आपकी मीटिंग नहीं रख सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ora che togli al sonno è un’ora in cui nessuno può fissarti una riunione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眠りから取り戻した 1 時間は、誰も会議を入れられない 1 時間だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠에서 되찾은 한 시간은 누구도 회의를 잡을 수 없는 한 시간이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora que você tira do sono é uma hora em que ninguém pode marcar uma reunião."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый час, отобранный у сна, — это час, в который никто не назначит совещание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你从睡眠里夺回的每一小时，都是没人能安排会议的一小时。"
          }
        }
      }
    },
    "typing.sentence.epic.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body follows the body: stand up first, and the willingness arrives about ninety seconds later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجسد يتبع الجسد: قف أولاً، وستأتي الرغبة بعد تسعين ثانية تقريباً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Körper folgt dem Körper: steh erst auf, die Bereitschaft kommt neunzig Sekunden später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo sigue al cuerpo: levántate primero y las ganas llegan unos noventa segundos después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps suit le corps : levez-vous d’abord, l’envie arrive quatre-vingt-dix secondes plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर शरीर का अनुसरण करता है: पहले खड़े हों, इच्छा करीब नब्बे सेकंड बाद आ जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo segue il corpo: alzati prima, e la voglia arriva novanta secondi dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体は体に従う。まず立ち上がれば、やる気は 90 秒ほど遅れてやって来る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸은 몸을 따른다. 먼저 일어서면 의욕은 구십 초쯤 뒤에 온다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O corpo segue o corpo: levante primeiro, e a vontade chega uns noventa segundos depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тело следует за телом: сначала встань, а желание придёт секунд через девяносто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身体听从身体：先站起来，意愿大约九十秒后才到。"
          }
        }
      }
    },
    "typing.sentence.long.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discipline is choosing what you want most over what you want now."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانضباط هو أن تختار ما تريده أكثر بدلاً من ما تريده الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Disziplin heißt, das Wichtigste über das Jetzige zu stellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disciplina es elegir lo que más quieres sobre lo que quieres ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La discipline, c’est choisir ce qu’on veut le plus plutôt que ce qu’on veut maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुशासन का मतलब है, जो सबसे ज़्यादा चाहिए उसे अभी की चाह से ऊपर रखना।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La disciplina è scegliere ciò che vuoi di più invece di ciò che vuoi adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規律とは、いま欲しいものより、いちばん欲しいものを選ぶことだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규율이란 지금 원하는 것보다 가장 원하는 것을 택하는 일이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disciplina é escolher o que você mais quer em vez do que quer agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисциплина — это выбрать то, чего хочешь больше всего, а не то, чего хочется сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自律，就是选择你最想要的，而不是你此刻想要的。"
          }
        }
      }
    },
    "typing.sentence.long.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The alarm did not fail you; you negotiated with it and lost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يخذلك المنبه، بل تفاوضت معه وخسرت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Alarm hat nicht versagt; du hast mit ihm verhandelt und verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La alarma no falló; negociaste con ella y perdiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alarme n’a pas failli ; vous avez négocié avec elle et perdu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म ने धोखा नहीं दिया, आपने उससे सौदा किया और हार गए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sveglia non ti ha tradito: hai negoziato con lei e hai perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームは裏切っていない。交渉して、あなたが負けただけだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 실패한 게 아니다. 협상하다 당신이 진 것이다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O alarme não falhou; você negociou com ele e perdeu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будильник не подвёл — ты с ним поторговался и проиграл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闹钟没有失职，是你和它谈判，然后输了。"
          }
        }
      }
    },
    "typing.sentence.long.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing good has ever come from the fourth press of snooze."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يأتِ خير قط من التأجيل الرابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem vierten Schlummern ist noch nie etwas Gutes geworden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca ha salido nada bueno de la cuarta posposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de bon n’est jamais sorti du quatrième rappel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चौथी बार स्नूज़ दबाने से आज तक कुछ अच्छा नहीं निकला।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
