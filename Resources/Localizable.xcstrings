    "mission.camera.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mission needs the camera. Allow it in Settings, or skip the mission this once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج هذه المهمة إلى الكاميرا. اسمح بها من الإعدادات أو تخطَّ المهمة هذه المرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mission braucht die Kamera. Erlaube sie in den Einstellungen oder überspringe sie dieses Mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta misión necesita la cámara. Permítela en Ajustes o sáltala esta vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mission a besoin de la caméra. Autorisez-la dans Réglages, ou passez la mission cette fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मिशन को कैमरा चाहिए। सेटिंग में अनुमति दें, या इस बार मिशन छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa missione richiede la fotocamera. Consentila in Impostazioni o salta la missione per questa volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このミッションにはカメラが必要です。設定で許可するか、今回は飛ばしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미션은 카메라가 필요합니다. 설정에서 허용하거나 이번만 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
