          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las alarmas de abajo están apagadas. No sonará nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les alarmes ci-dessous sont désactivées. Rien ne sonnera."
