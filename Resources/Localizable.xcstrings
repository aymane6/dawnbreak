    "widget.next.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time you are getting up and what it will take to stop the alarm."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت الذي ستستيقظ فيه وما يتطلبه إيقاف المنبه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann du aufstehst und was nötig ist, um den Alarm zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A qué hora te levantas y qué hará falta para parar la alarma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de votre réveil et ce qu’il faudra faire pour arrêter l’alarme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कब उठेंगे और अलार्म रोकने के लिए क्या करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che ora ti alzi e cosa serve per fermare la sveglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時刻と、アラームを止めるために必要なこと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어날 시각과 알람을 멈추기 위해 해야 할 일."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A que horas você vai levantar e o que será preciso para parar o alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во сколько вы встаёте и что потребуется, чтобы выключить будильник."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的起床时间，以及关掉闹钟需要做什么。"
          }
        }
      }
    },
