        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone कदम नहीं गिन सकता, इसलिए यह मिशन पूरा नहीं हो सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non può contare i passi: la missione non può concludersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は歩数を数えられないため、このミッションは完了できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 걸음 수를 셀 수 없어 이 미션을 끝낼 방법이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não conta passos, então esta missão não tem como terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не умеет считать шаги, поэтому задание невозможно завершить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 无法计步，该任务无法完成。"
          }
        }
      }
