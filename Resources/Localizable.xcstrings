    "mission.steps.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak cannot read your steps. Allow Motion & Fitness in Settings, or skip this once."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Dawnbreak قراءة خطواتك. اسمح بالحركة واللياقة من الإعدادات أو تخطَّ هذه المرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak kann deine Schritte nicht lesen. Erlaube Bewegung & Fitness in den Einstellungen oder überspringe dieses Mal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak no puede leer tus pasos. Permite Movimiento y Fitness en Ajustes, o sáltalo esta vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak ne peut pas lire vos pas. Autorisez Mouvement et Forme dans Réglages, ou passez cette fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak आपके कदम नहीं पढ़ सकता। सेटिंग में मोशन और फ़िटनेस की अनुमति दें, या इस बार छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak non può leggere i tuoi passi. Consenti Movimento e fitness in Impostazioni o salta per questa volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak は歩数を読み取れません。設定で「モーションとフィットネス」を許可するか、今回は飛ばしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak가 걸음 수를 읽을 수 없습니다. 설정에서 동작 및 피트니스를 허용하거나 이번만 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dawnbreak não consegue ler seus passos. Permita Movimento e Preparo Físico em Ajustes ou pule desta vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak не может считать ваши шаги. Разрешите «Движение и фитнес» в настройках или пропустите на этот раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawnbreak 无法读取你的步数。请在“设置”中允许“运动与健身”，或本次跳过。"
          }
        }
      }
    },
