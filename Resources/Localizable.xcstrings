    "paywall.feature.stats.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every wake time, every streak, and every morning you stopped the alarm without doing the mission."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل أوقات الاستيقاظ، كل السلاسل، وكل صباح أوقفت فيه المنبه دون إنجاز المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Weckzeit, jede Serie und jeder Morgen, an dem du den Alarm ohne Mission gestoppt hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora de despertar, cada racha y cada mañana en la que paraste la alarma sin hacer la misión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure de réveil, chaque série, et chaque matin où vous avez arrêté l’alarme sans faire la mission."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर जागने का समय, हर सिलसिला, और हर वह सुबह जब आपने मिशन किए बिना अलार्म रोक दिया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ora di risveglio, ogni serie, e ogni mattina in cui hai fermato la sveglia senza fare la missione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起床時刻のすべて、連続記録のすべて、そしてミッションをせずにアラームを止めた朝のすべて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기상 시각, 모든 연속 기록, 그리고 미션 없이 알람을 끈 모든 아침."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora de despertar, cada sequência e cada manhã em que você parou o alarme sem fazer a missão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое время подъёма, каждая серия и каждое утро, когда вы выключили будильник без задания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次起床时间、每一段连续记录，以及每一个你没做任务就关掉闹钟的早晨。"
          }
        }
      }
    },
    "paywall.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is taken by Apple. Subscriptions renew until cancelled; manage or cancel in your App Store account settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع يتم عبر Apple. تتجدد الاشتراكات حتى الإلغاء؛ يمكنك الإدارة أو الإلغاء من إعدادات حسابك في App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung erfolgt über Apple. Abos verlängern sich bis zur Kündigung; Verwaltung und Kündigung in den App-Store-Kontoeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago lo gestiona Apple. Las suscripciones se renuevan hasta que las canceles; gestiónalas en los ajustes de tu cuenta de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paiement est encaissé par Apple. Les abonnements se renouvellent jusqu’à résiliation ; gérez-les dans les réglages de votre compte App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान Apple लेता है। सब्सक्रिप्शन रद्द होने तक रिन्यू होती रहती है; App Store खाता सेटिंग में प्रबंधित या रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è gestito da Apple. Gli abbonamenti si rinnovano fino alla disdetta; gestiscili nelle impostazioni del tuo account App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払いは Apple が処理します。サブスクリプションは解約するまで更新されます。App Store のアカウント設定で管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제는 Apple이 처리합니다. 구독은 해지할 때까지 갱신되며, App Store 계정 설정에서 관리하거나 해지할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento é feito pela Apple. As assinaturas renovam até serem canceladas; gerencie nas configurações da sua conta da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплату принимает Apple. Подписки продлеваются до отмены; управлять ими можно в настройках аккаунта App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "款项由 Apple 收取。订阅在取消前会自动续费；可在 App Store 账户设置中管理或取消。"
          }
        }
      }
    },
