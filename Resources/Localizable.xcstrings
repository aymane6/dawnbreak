    "paywall.subhead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All twelve missions, twenty-five alarms, every difficulty. One app, no account, no adverts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل المهام الاثنتَي عشرة، خمسة وعشرون منبهاً، كل مستويات الصعوبة. تطبيق واحد، بلا حساب، بلا إعلانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zwölf Missionen, 25 Alarme, jede Schwierigkeit. Eine App, kein Konto, keine Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las doce misiones, veinticinco alarmas, todas las dificultades. Una app, sin cuenta, sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les douze missions, vingt-cinq alarmes, toutes les difficultés. Une app, sans compte, sans publicité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी बारह मिशन, पच्चीस अलार्म, हर कठिनाई। एक ऐप, कोई अकाउंट नहीं, कोई विज्ञापन नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le dodici missioni, venticinque sveglie, ogni difficoltà. Un’app, nessun account, nessuna pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12 のミッションすべて、アラーム 25 個、すべての難易度。アカウント不要、広告なし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열두 가지 미션 전부, 알람 25개, 모든 난이도. 계정도 광고도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as doze missões, vinte e cinco alarmes, todas as dificuldades. Um app, sem conta, sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все двенадцать заданий, двадцать пять будильников, любая сложность. Одно приложение, без аккаунта и рекламы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部十二种任务、二十五个闹钟、所有难度。一个应用，无需账号，没有广告。"
          }
        }
      }
    },
